{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs": "pnpm -C apps/docs start",
    "demo": "pnpm -C apps/demos demo",
    "log-viewer": "pnpm -C apps/log-viewer demo",
    "react": "pnpm -C apps/react demo",
    "react:dev": "pnpm -C apps/react dev",
    "ci:prepublish:build": "pnpm --filter './packages/*' --workspace-concurrency=1 -r --if-present build",
    "ci:publish": "pnpm -r publish --access public --no-git-checks",
    "bump": "node shared/bump.js",
    "clean": "rm -rf packages/*/.dist apps/*/.dist",
    "format": "oxfmt && oxlint --fix",
    "prepare": "husky",
    "check": "oxfmt --check && oxlint"
  },
  "devDependencies": {
    "@types/node": "^20.3.2",
    "oxfmt": "^0.37.0",
    "oxlint": "^1.64.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js",
      "core-js-pure"
    ],
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "sharp"
    ],
    "overrides": {
      "minimatch": "9.0.7",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "js-yaml@>=3.0.0 <3.14.2": "3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "ajv@<6.14.0": ">=6.14.0",
      "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
      "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2"
    }
  }
}
