{
  "name": "@teaui/result",
  "description": "Dependency-free Result types and constructors",
  "author": "Colin T.A. Gray <colinta@colinta.com>",
  "version": "1.19.18",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/colinta/teaui"
  },
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.js",
      "default": "./.dist/index.js"
    }
  },
  "main": ".dist/index.js",
  "types": ".dist/index.d.ts",
  "files": [
    ".dist/"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf .dist/",
    "_build": "pnpm clean && pnpm tsc",
    "build": "node ../../shared/check.js",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@teaui/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
