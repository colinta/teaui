{
  "type": "module",
  "name": "@teaui/cli",
  "description": "CLI for @teaui packages",
  "author": "Colin T.A. Gray <colinta@colinta.com>",
  "contributors": [],
  "version": "1.26.25",
  "license": "MIT",
  "preferGlobal": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/colinta/teaui"
  },
  "homepage": "https://github.com/colinta/teaui",
  "main": ".dist/index.js",
  "bin": {
    "teaui": ".dist/bin.js"
  },
  "types": ".dist/index.d.ts",
  "files": [
    ".dist/"
  ],
  "bugs": {
    "url": "http://github.com/colinta/teaui/issues"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf .dist/",
    "_build": "pnpm clean && pnpm tsc && cp -r frameworks .dist/ && cp lib/examples/samples/*.core.js lib/examples/samples/*.react.tsx .dist/examples/samples/",
    "build": "node ../../shared/check.js"
  },
  "keywords": [
    "curses",
    "tui",
    "terminal",
    "text-ui",
    "terminal-ui"
  ],
  "tags": [
    "curses",
    "tui",
    "terminal"
  ],
  "engines": {
    "node": ">= 18.12.0"
  },
  "dependencies": {
    "@teaui/code": "workspace:*",
    "@teaui/core": "workspace:*",
    "@teaui/image": "workspace:*",
    "@teaui/react": "workspace:*",
    "@teaui/subprocess": "workspace:*",
    "commander": "^14.0.0",
    "react": "^18.2.0",
    "react-reconciler": "^0.29.0"
  },
  "devDependencies": {
    "@teaui/shared": "workspace:*",
    "@types/react": "^18.2.39"
  },
  "publishConfig": {
    "access": "public"
  }
}
